import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner scan = new Scanner(System.in);
        int R = scan.nextInt();
        int B = scan.nextInt();
        if(R <= B * 6){
            System.out.println("YES");
        }else{
            System.out.println("NO");
        }
        scan.close();
    }
}
