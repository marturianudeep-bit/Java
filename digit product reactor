import java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        long n = sc.nextLong();
        int reactions = 0;

        while (n >= 10) {
            long product = 1;

            while (n > 0) {
                product *= n % 10;
                n /= 10;
            }

            n = product;
            reactions++;
        }

        System.out.println(reactions + " " + n);
    }
}
