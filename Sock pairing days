
import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int a = sc.nextInt();
        int b = sc.nextInt();

        int mismatched = Math.min(a, b);
        int remaining = Math.abs(a - b);
        int matching = remaining / 2;

        System.out.println(mismatched + " " + matching);
    }
}
