import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int m1 = sc.nextInt();
        int m2 = sc.nextInt();
        int m3 = sc.nextInt();

        int below40 = 0;

        if (m1 < 40) below40++;
        if (m2 < 40) below40++;
        if (m3 < 40) below40++;

        int total = m1 + m2 + m3;

        if (below40 == 0) {
            System.out.println("PASS");
        } else if (below40 == 1 &&
                   m1 >= 35 && m2 >= 35 && m3 >= 35 &&
                   total >= 150) {
            System.out.println("GRACE PASS");
        } else {
            System.out.println("FAIL");
        }
    }
}
