import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int t = sc.nextInt();

        while (t-- > 0) {
            int n = sc.nextInt();
            String s = sc.next();

            int count = 0;

            if (!s.contains("#")) {
                count = (n + 1) / 2;
            } else {
                int dots = 0;

                for (int i = 0; i < n; i++) {
                    if (s.charAt(i) == '.') {
                        dots++;
                    }
                }

                count = (dots + 2) / 3;
            }

            System.out.println(count);
        }

        sc.close();
    }
}
