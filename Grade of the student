import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        for (int i = 0; i < 3; i++) {
            int marks = sc.nextInt();

            if (marks > 90)
                System.out.print("A ");
            else if (marks > 70)
                System.out.print("B ");
            else if (marks >= 40)
                System.out.print("C ");
            else
                System.out.print("F ");
        }
    }
}
