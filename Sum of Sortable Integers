class Solution {
    public int sumOfSortableIntegers(int[] nums) {
        int n = nums.length;
        int ans = 0;

        for (int k = 1; k <= n; k++) {
            if (n % k != 0) continue;

            int[] sorted = nums.clone();
            java.util.Arrays.sort(sorted);

            boolean ok = true;

            for (int start = 0; start < n && ok; start += k) {
                int shift = -1;

                for (int j = 0; j < k; j++) {
                    if (nums[start + j] == sorted[start]) {
                        shift = j;
                        break;
                    }
                }

                if (shift == -1) {
                    ok = false;
                    break;
                }

                for (int j = 0; j < k; j++) {
                    if (nums[start + (j + shift) % k] != sorted[start + j]) {
                        ok = false;
                        break;
                    }
                }
            }

            if (ok) ans += k;
        }

        return ans;
    }
}
