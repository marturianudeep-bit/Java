import java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int[] arr = new int[n];

        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        int k = sc.nextInt();

        int breaks = 0;

        for (int i = 0; i < n - 1; i++) {
            if (arr[i] > arr[i + 1]) {
                breaks++;
            }
        }

        if (breaks != 1) {
            System.out.println("Invalid");
            return;
        }

        for (int i = 0; i < n; i++) {
            if (arr[i] == k) {
                System.out.println(i);
                return;
            }
        }

        System.out.println(-1);
    }
}
