import java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int t = sc.nextInt();

        while (t-- > 0) {
            int alex = sc.nextInt();
            int count = 0;

            for (int i = 0; i < 3; i++) {
                if (sc.nextInt() > alex)
                    count++;
            }

            System.out.println(count);
        }
    }
}
