class Solution
  {
    public static int smallest_positive(int arr[],int n)
      {
        int missing_number = 0;
    for(int i=1;i<=n*1;i++){
        boolean found=false;
        for(int j=0;j<n;j++){
            if(arr[j]==i){
                found = true;
                break;
            }
        }
        if(!found){
            missing_number=i;
            break;
        }
    }
    return missing_number;
      }
  }
