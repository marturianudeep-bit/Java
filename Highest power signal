import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        long n = sc.nextLong();
        long power = 1;

        while (power * 2 <= n) {
            power = power * 2;
        }

        long unused = n - power;

        System.out.println("Power: " + power);
        System.out.println("Unused: " + unused);
    }
}
