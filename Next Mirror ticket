
import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();

        n++;

        while (true) {
            String s = String.valueOf(n);
            String rev = new StringBuilder(s).reverse().toString();

            if (s.equals(rev)) {
                System.out.println(n);
                break;
            }

            n++;
        }
    }
}
