
import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int t = sc.nextInt();

        while (t-- > 0) {
            int n = sc.nextInt();
            int count = 0;

            while (n % 6 == 0) {
                n /= 6;
                count++;
            }

            while (n % 2 == 0 && n > 1) {
                n /= 2;
                count++;
            }

            if (n == 1) {
                System.out.println(count);
            } else {
                System.out.println(-1);
            }
        }
    }
}
