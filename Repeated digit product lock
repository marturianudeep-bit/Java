import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        long n = sc.nextLong();
        int count = 0;

        while (n >= 10) {
            long product = 1;

            while (n > 0) {
                product *= n % 10;
                n /= 10;
            }

            n = product;
            count++;
        }

        System.out.println("Final Digit: " + n);
        System.out.println("Persistence: " + count);
    }
}
