
import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int even = 0, odd = 0;
        int evenIndex = 0, oddIndex = 0;

        for (int i = 1; i <= n; i++) {
            int num = sc.nextInt();

            if (num % 2 == 0) {
                even++;
                evenIndex = i;
            } else {
                odd++;
                oddIndex = i;
            }
        }

        if (even == 1)
            System.out.println(evenIndex);
        else
            System.out.println(oddIndex);
    }
}
