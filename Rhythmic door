import java.util.*;

public class Main{
    public static void main(String[] args){
        Scanner scan = new Scanner(System.in);
        int T = scan.nextInt();
        
        while(T-->0){
            int N = scan.nextInt();
            String S = scan.next();
            
            int count = 0;
            int ans = 0;
            char prev = S.charAt(0);
            
            for(int i=0; i < N; i++){
                if(S.charAt(i) == prev){
                    count++;
                }else{
                    prev = S.charAt(i);
                    count = 1;
                }
                if(count == 3){
                    ans++;
                    count = 0;
                }
            }
            System.out.println(ans);
        }
    }
}
